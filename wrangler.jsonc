{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trackstage",
  // Custom entry wrapping @tanstack/react-start/server-entry: it slices
  // /launch.mp4 into real 206 Range responses so the film is seekable, and
  // delegates everything else. (Was briefly reverted 2026-08-12 as an outage
  // suspect — the sign-in 404 turned out to be the x-forwarded-host header in
  // the auth proxy, not this entry.)
  "main": "src/server.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Smart Placement: SSR does several Convex roundtrips per request, so let
  // Cloudflare run the Worker near the backend (aws-us-east-1) instead of near
  // the visitor — fewer transatlantic hops per page for the US-based judge.
  // Falls back to default placement automatically when it wouldn't help.
  "placement": { "mode": "smart" },
  // Production custom domain. Cloudflare provisions the DNS record and the
  // certificate from this declaration on `wrangler deploy` — the zone
  // (trackstage.app) lives in the same account as the Worker.
  // The workers.dev URL (https://trackstage.kortix.workers.dev) stays live as
  // a fallback; convex/auth.ts trusts both origins.
  "routes": [{ "pattern": "trackstage.app", "custom_domain": true }],
  // Declaring `routes` would otherwise turn the workers.dev URL off; keep it
  // on so https://trackstage.kortix.workers.dev remains a working fallback.
  "workers_dev": true,
  // Static assets answer before the Worker runs — except the launch film,
  // which routes through the Worker so seeking gets real 206 responses.
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/launch.mp4"]
  },
  // Staging Worker: dev.trackstage.app, deployed by deploy-dev.yml on every
  // green CI run of main/master. Built with `CLOUDFLARE_ENV=dev vite build
  // --mode staging` (.env.staging → the shared DEV Convex deployment
  // neat-sparrow-926), so it never touches production data.
  "env": {
    "dev": {
      "name": "trackstage-dev",
      "routes": [{ "pattern": "dev.trackstage.app", "custom_domain": true }],
      "workers_dev": true,
      "observability": { "enabled": true },
      // assets is a per-environment key (not inherited) — mirror the
      // top-level block so staging seeks the same way production does.
      "assets": {
        "binding": "ASSETS",
        "run_worker_first": ["/launch.mp4"]
      }
    }
  }
}

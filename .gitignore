# Capture scratch — stills + intermediate video for the screenshot/GIF scripts.
# Kept on disk between runs so `capture-tour-gif.mjs --gif` can re-assemble
# without re-driving the browser; never committed (the GIF itself is).
.screenshot-frames/
.tour-frames/


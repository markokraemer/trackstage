# Production build-time environment (mode=production, i.e. `pnpm build`).
#
# These are PUBLIC values — they are compiled into the client bundle, so they
# are committed on purpose (see the `!.env.production` exception in .gitignore).
# Every real secret lives in the Convex prod deployment (`convex env set … --prod`)
# or as a Cloudflare Worker secret (`wrangler secret put …`) — never here.
#
# Vite loads .env.production AFTER .env.local, so a production build always
# points at the production Convex deployment even on a developer machine.
# Consequence: `pnpm preview` (vite build && wrangler dev) talks to PROD Convex.
# Use `pnpm dev` for the dev deployment.

# Convex production deployment: prod:keen-eagle-41
VITE_CONVEX_URL=https://keen-eagle-41.convex.cloud
VITE_CONVEX_SITE_URL=https://keen-eagle-41.convex.site

# Public origin of the deployed app (custom domain attached in wrangler.jsonc).
# https://trackstage.kortix.workers.dev stays live as a fallback origin.
VITE_SITE_URL=https://trackstage.app

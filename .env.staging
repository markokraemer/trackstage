# Staging build-time environment (mode=staging, i.e. `vite build --mode staging`).
#
# These are PUBLIC values compiled into the client bundle — committed on
# purpose, exactly like .env.production (see the `!.env.staging` exception in
# .gitignore). No secrets, ever.
#
# The staging Worker (trackstage-dev → https://dev.trackstage.app, defined as
# `env.dev` in wrangler.jsonc) is built against the shared DEV Convex
# deployment — the same one local `pnpm dev` uses — so staging always shows
# the current state of development, seeded demo data included.

# Convex dev deployment: dev:neat-sparrow-926
VITE_CONVEX_URL=https://neat-sparrow-926.eu-west-1.convex.cloud
VITE_CONVEX_SITE_URL=https://neat-sparrow-926.eu-west-1.convex.site

# Public origin of the staging app.
VITE_SITE_URL=https://dev.trackstage.app

# Staging runs against the seeded dev deployment — show the demo entrances.
VITE_DEMO_MODE=1

# Branded origin for the ADVERTISED public API/MCP endpoints (docs, settings
# cards, embeds, .ics feeds). Attached to the dev Convex deployment as a
# custom domain; the auth wiring stays on VITE_CONVEX_SITE_URL above.
VITE_PUBLIC_API_URL=https://dev-api.trackstage.app

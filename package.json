{
  "name": "trackstage",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "build:staging": "CLOUDFLARE_ENV=dev vite build --mode staging",
    "preview": "vite build && wrangler dev",
    "test": "vitest run",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx}\"",
    "check": "prettier --check \"**/*.{ts,tsx,js,jsx}\"",
    "typecheck": "tsc --noEmit",
    "dev:setup": "convex dev --once",
    "dev:convex": "convex dev",
    "deploy": "convex deploy -y && vite build && wrangler deploy && node scripts/smoke-production.mjs",
    "smoke": "node scripts/smoke-production.mjs",
    "cf-typegen": "wrangler types --include-runtime=false",
    "test:backend": "convex run seed:setup && node scripts/verify-backend.mjs",
    "test:e2e": "playwright test",
    "test:flows": "playwright test --project=flows",
    "test:all": "pnpm test && pnpm test:backend && pnpm test:e2e",
    "prompts:regen": "node scripts/extract-prompts.mjs",
    "openapi:regen": "node scripts/generate-openapi.mjs",
    "openapi:check": "node scripts/generate-openapi.mjs --check",
    "openapi:verify": "node scripts/generate-openapi.mjs --check --live"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.29",
    "@ai-sdk/react": "^4.0.61",
    "@base-ui/react": "^1.7.0",
    "@convex-dev/better-auth": "^0.12.5",
    "@convex-dev/react-query": "^0.1.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@remixicon/react": "^4.9.0",
    "@rive-app/react-webgl2": "^4.31.0",
    "@shadcn/react": "^0.3.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-devtools": "0.10.9",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "1.170.25",
    "@tanstack/react-router-devtools": "1.167.1",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "1.168.42",
    "@tanstack/router-plugin": "1.168.29",
    "@xyflow/react": "^12.11.2",
    "ai": "^7.0.58",
    "ansi-to-react": "^6.2.6",
    "better-auth": "^1.6.26",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.43.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "fumadocs-core": "^16.14.3",
    "fumadocs-ui": "^16.14.3",
    "lucide-react": "^1.31.0",
    "media-chrome": "^4.19.2",
    "motion": "^13.0.0",
    "nanoid": "^6.0.1",
    "next-themes": "^0.4.6",
    "react": "^19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.6",
    "react-jsx-parser": "^2.4.1",
    "shadcn": "^4.16.2",
    "shiki": "^4.4.2",
    "sonner": "^2.0.8",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tokenlens": "^1.3.1",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.1",
    "@playwright/test": "^1.62.1",
    "@tanstack/devtools-vite": "0.8.3",
    "@tanstack/eslint-config": "0.4.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^9",
    "jsdom": "^28",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "^6",
    "vite": "^8",
    "vitest": "^4",
    "wrangler": "^4.120.0"
  }
}
